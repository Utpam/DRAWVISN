# .env.example — DRAWVISN Firebase Configuration
#
# Copy this file to .env and fill in your Firebase project values.
# Never commit .env to version control — it is already listed in .gitignore.
#
# To find these values:
#  1. Go to https://console.firebase.google.com
#  2. Open your project → Project Settings → General
#  3. Under "Your apps", select your web app
#  4. Copy the config object values below

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id_here
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_app_id_here

# Realtime Collaboration Server (Socket.IO)
VITE_SOCKET_URL=http://localhost:3001
